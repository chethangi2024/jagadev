---
// Google Map that loads only after the visitor taps "Show map" (no third-party cookies by default).
import Icon from './Icon.astro';
import { site } from '../lib/site';
const src = site.mapEmbedUrl;
---
<div class="map" data-map data-src={src}>
  <div class="map-placeholder">
    <Icon name="pin" size={28} />
    <p>The map is provided by Google and loads only if you choose to show it.</p>
    <div class="btn-row">
      <button class="btn btn-primary" type="button" data-map-load>Show map</button>
      <a class="btn btn-outline" href={site.mapsLink} target="_blank" rel="noopener"><Icon name="directions" />Open in Google Maps</a>
    </div>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((el) => {
    el.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = el.dataset.src!;
      f.title = 'Map showing the office location';
      f.loading = 'lazy';
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      f.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      f.setAttribute('allowfullscreen', '');
      f.setAttribute('style', 'border:0;width:100%;min-height:320px;');
      el.replaceChildren(f);
    });
  });
</script>
<style>
  .map { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--rule); background: var(--sky-tint); min-height: 320px; display: grid; }
  .map-placeholder { display: grid; place-content: center; justify-items: center; text-align: center; gap: .5rem; padding: 2rem; color: var(--sky-ink); }
  .map-placeholder p { color: var(--muted); max-width: 36ch; margin: 0 0 .5rem; font-size: var(--step--1); }
  .map :global(iframe) { width: 100%; height: 100%; min-height: 320px; border: 0; }
</style>
