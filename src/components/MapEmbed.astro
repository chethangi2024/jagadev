---
import { site } from '../lib/site';
---
<div class="map-wrap">
  <div class="map">
    <iframe
      src={site.mapEmbedUrl}
      title="Map showing the Jagadev Associates office"
      loading="lazy"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
      style="border:0;width:100%;height:100%;"
    ></iframe>
  </div>
  <a class="map-link" href={site.mapsLink} target="_blank" rel="noopener">Open in Google Maps</a>
</div>

<style>
  .map-wrap { display: flex; flex-direction: column; }
  .map { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--rule); background: var(--sky-tint); min-height: 320px; display: grid; }
  .map iframe { display: block; width: 100%; height: 100%; min-height: 320px; border: 0; }
  .map-link { display: inline-block; font-size: var(--step--1); font-weight: 600; color: var(--sky-ink); margin-top: .5rem; text-decoration: none; align-self: flex-start; }
  .map-link:hover { text-decoration: underline; color: var(--navy); }
</style>
