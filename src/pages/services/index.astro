---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import ContactBand from '../../components/ContactBand.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Services', href: '/services' }];
---
<BaseLayout
  title="Services: GST, Income Tax, Company & LLP, Accounting | Jagadev Associates"
  description="Business registrations, tax filing, company and LLP compliance, accounting, payroll and statutory compliance services in Kothanur, Bengaluru."
  breadcrumbs={crumbs}
>
  <PageHero
    title="Our services"
    intro="Registrations, returns, accounts and filings, grouped into five areas. Open any service to see what is included and which documents to bring."
    crumbs={crumbs}
    image="https://images.unsplash.com/photo-1772588627342-5ec373e236d8?auto=format&fit=crop&w=2000&q=70"
  />
  <section class="section">
    <div class="wrap svc-list">
      {services.map((s, i) => (
        <article class:list={['svc-row', { flip: i % 2 === 1 }]}>
          <div class="svc-media" data-reveal={i % 2 ? 'right' : 'left'}>
            <Photo src={s.data.image} alt={s.data.imageAlt ?? ''} ratio="3 / 2" />
            <span class="svc-num" aria-hidden="true"><Icon name={s.data.icon} size={30} /></span>
          </div>
          <div class="svc-copy">
            <h2 data-reveal="up"><a href={`/services/${s.id}`}>{s.data.title}</a></h2>
            <p data-reveal="up">{s.data.summary}</p>
            <ul class="svc-incl" data-stagger="up">
              {s.data.includes.map((inc) => <li><Icon name="check" size={18} />{inc.name}</li>)}
            </ul>
            <div data-reveal="up"><a class="btn btn-navy" href={`/services/${s.id}`}>View details <Icon name="arrow" /></a></div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <ContactBand />
</BaseLayout>

<style>
  .svc-list { display: grid; gap: clamp(4rem, 9vw, 6.5rem); }
  .svc-row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .svc-row.flip .svc-media { order: 2; }
  .svc-media { position: relative; }
  .svc-num { position: absolute; right: -14px; bottom: -14px; display: grid; place-items: center; width: 74px; height: 74px; border-radius: 20px; background: var(--sky); color: #fff; box-shadow: 0 14px 30px -12px rgba(33,155,193,.9); border: 5px solid #fff; }
  .flip .svc-num { right: auto; left: -14px; }
  .svc-copy h2 a { color: inherit; text-decoration: none; }
  .svc-copy h2 a:hover { color: var(--sky-ink); }
  .svc-copy > p { color: var(--muted); font-size: var(--step-1); }
  .svc-incl { list-style: none; padding: 0; margin: 1.25rem 0 2rem; display: grid; grid-template-columns: 1fr 1fr; gap: .65rem 1.25rem; }
  .svc-incl li { display: flex; gap: .5rem; align-items: flex-start; font-weight: 550; font-size: .975rem; }
  .svc-incl :global(svg) { color: var(--sky); flex: none; margin-top: .2rem; }
  @media (max-width: 860px) {
    .svc-row { grid-template-columns: 1fr; }
    .svc-row.flip .svc-media { order: 0; }
    .flip .svc-num { left: auto; right: -6px; }
    .svc-num { right: -6px; }
  }
  @media (max-width: 480px) { .svc-incl { grid-template-columns: 1fr; } }
</style>
