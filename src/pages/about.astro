---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ContactBand from '../components/ContactBand.astro';
import about from '../content/pages/about.json';
import { site } from '../lib/site';
const crumbs = [{ name: 'About', href: '/about' }];
---
<BaseLayout
  title="About Jagadev Associates LLP | Tax & Compliance Practice in Kothanur, Bengaluru"
  description="Jagadev Associates LLP is a tax, audit and corporate affairs practice in Kothanur, Bengaluru, working with businesses and individuals in person and remotely."
  breadcrumbs={crumbs}
>
  <PageHero title={about.title} intro={about.intro} crumbs={crumbs} image={about.heroImage} imageAlt={about.heroImageAlt} />

  <section class="section">
    <div class="wrap about-grid">
      <div class="story" data-stagger="up">
        {about.story.map((p) => <p>{p}</p>)}
        <dl class="reg">
          <div><dt>Registered name</dt><dd>{site.firmName}</dd></div>
          <div><dt>LLPIN</dt><dd>{site.llpin}</dd></div>
          <div><dt>Office hours</dt><dd>{site.hours.days}, {site.hours.time}</dd></div>
        </dl>
      </div>
      <figure class="partner" data-reveal="right">
        <Photo src={about.partner.photo || undefined} alt={about.partner.photoAlt} ratio="4 / 5" />
        <figcaption>
          <strong>{about.partner.name}</strong>
          <span>{about.partner.role}</span>
          <p>{about.partner.bio}</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <h2 data-reveal="up">How we work with clients</h2>
      <ul class="values" data-stagger="up">
        {about.values.map((v) => <li><h3>{v.title}</h3><p>{v.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="office">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker" data-reveal="up">Our office</p>
        <h2 data-reveal="up">A look inside</h2>
        <p data-reveal="up">A look inside our office in Bhoo Vaibhava Layout, Kothanur.</p>
      </div>
      <div class="gallery" data-stagger="zoom">
        {about.gallery.map((g, i) => <Photo src={g.src} alt={g.alt} ratio={i === 0 ? '4 / 3' : '1 / 1'} class={i === 0 ? 'g-big' : ''} />)}
      </div>
    </div>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  .about-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .story p { font-size: var(--step-1); line-height: 1.65; max-width: 58ch; }
  .reg { margin: 2rem 0 0; border-top: 2px solid var(--navy); }
  .reg div { display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid var(--rule); }
  .reg dt { color: var(--muted); }
  .reg dd { margin: 0; font-weight: 600; color: var(--navy); }
  .partner { margin: 0; }
  .partner figcaption { margin-top: 1rem; display: grid; gap: .15rem; }
  .partner strong { font-family: var(--head); font-size: 1.5rem; color: var(--navy); font-weight: 750; }
  .partner span { color: var(--sky-ink); font-weight: 600; }
  .partner p { color: var(--muted); margin-top: .5rem; }
  .values { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .values li { background: #fff; border-radius: var(--radius-lg); padding: 2rem 1.75rem; border-top: 4px solid var(--sky); box-shadow: 0 1px 2px rgba(14,42,71,.06); }
  .values p { color: var(--muted); margin: 0; }
  .gallery { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: auto auto; gap: 1rem; }
  .gallery :global(.g-big) { grid-row: span 2; height: 100%; aspect-ratio: auto !important; min-height: 320px; }
  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; }
    .partner { max-width: 420px; }
    .values { grid-template-columns: 1fr; }
    .gallery { grid-template-columns: 1fr 1fr; }
    .gallery :global(.g-big) { grid-column: span 2; grid-row: auto; aspect-ratio: 4 / 3 !important; min-height: 0; }
  }
  @media (max-width: 520px) { .reg div { grid-template-columns: 1fr; gap: .1rem; } }
</style>
