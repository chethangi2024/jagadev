---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { primaryPhone } from '../lib/site';
---
<BaseLayout title="Page not found | Jagadev Associates LLP" noindex>
  <section class="section">
    <div class="wrap nf">
      <h1>This page isn't here</h1>
      <p class="lead">The link may be old or mistyped. Try one of these instead.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-outline" href="/services">See all services</a>
        <a class="btn btn-outline" href={`tel:${primaryPhone.tel}`}><Icon name="phone" />Call us</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>.nf { min-height: 50vh; display: grid; align-content: center; }</style>
